---
import Base from '../../layouts/Base.astro';
import UseCaseCard from '../../components/UseCaseCard.astro';
import GuideCard from '../../components/GuideCard.astro';
import { listGuides } from '../../lib/guides';
import { USE_CASE_GROUPS } from '../../lib/useCaseGroups';
import { withBase } from '../../lib/withBase';
import { getCollection } from 'astro:content';
const all = (await getCollection('use-cases', ({ data }) => !data.draft)).sort((a, b) => a.data.title.localeCompare(b.data.title));
const guides = await listGuides();
---
<Base title="Use cases" description="Browse AI tools by the job: build, content, business, marketing, study, design and everyday productivity.">
  <div class="wrap">
    <section class="hero" style="padding-bottom:16px">
      <span class="eyebrow">Use cases</span>
      <h1>Pick the job. We'll pick the stack.</h1>
      <p class="lead">Jobs are grouped by the work, from building and content to marketing, study, design and everyday productivity. Each page gives a top pick, a budget pick, one to avoid and the full workflow. Pages marked <span class="tag pending">Pending hands-on test</span> rest on verified vendor facts only, until we've run our standard test.</p>
    </section>
    {USE_CASE_GROUPS.map((group) => {
      const items = all.filter((entry) => entry.data.category === group.category);
      return items.length > 0 && (
        <section>
          <h2>{group.label}</h2>
          <p class="lead">{group.intro}</p>
          <div class="grid">{items.map((entry) => <UseCaseCard entry={entry} />)}</div>
        </section>
      );
    })}
    {guides.length > 0 && (
      <section>
        <div class="section-head">
          <h2>Comparisons and shortlists</h2>
          <span><a href={withBase('/compare/')}>Comparisons</a> · <a href={withBase('/best/')}>Shortlists</a></span>
        </div>
        <div class="grid">{guides.map((guide) => <GuideCard {...guide} />)}</div>
      </section>
    )}
  </div>
</Base>
