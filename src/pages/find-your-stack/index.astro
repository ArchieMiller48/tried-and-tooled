---
import { withBase } from '../../lib/withBase';

const target = withBase('/find-your-tool/');
const canonical = new URL(target, Astro.site);
const redirectScript = `(function () {
  var target = ${JSON.stringify(target)};
  var dest = target + location.search + location.hash;
  var meta = document.createElement('meta');
  meta.id = 'tool-redirect';
  meta.httpEquiv = 'refresh';
  meta.content = '0;url=' + dest;
  document.head.appendChild(meta);
  location.replace(dest);
})();`;
const linkScript = `(function () {
  var target = ${JSON.stringify(target)};
  var link = document.getElementById('tool-redirect-link');
  if (link) link.href = target + location.search + location.hash;
})();`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Opening Find your tool · Tried &amp; Tooled</title>
    <meta name="description" content="This old address opens Find your tool. The quiz itself lives on that page." />
    <meta property="og:title" content="Opening Find your tool · Tried & Tooled" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, max-image-preview:large" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={new URL(`${import.meta.env.BASE_URL}sitemap-index.xml`, Astro.site)} />
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${target}`} />
    </noscript>
    <script is:inline set:html={redirectScript}></script>
    <style>
      body { margin: 48px 20px; font-family: ui-sans-serif, system-ui, sans-serif; color: #0f172a; line-height: 1.5; }
      a { color: #3f6212; }
    </style>
  </head>
  <body>
    <p>This page has moved. Continue to <a id="tool-redirect-link" href={target}>Find your tool</a>.</p>
    <script is:inline set:html={linkScript}></script>
  </body>
</html>
