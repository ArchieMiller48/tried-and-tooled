---
import GuideIndex from '../../components/GuideIndex.astro';
import { guideIndexEntries } from '../../lib/guides';

const entries = await guideIndexEntries('best');
---
<GuideIndex
  title="Shortlists"
  eyebrow="Best"
  description="Shortlists of AI tools for one job, with sourced pricing and a pending-test label until a hands-on task has been run."
  intro="Each shortlist is a reading guide for one job. The order is by who the tool is for, not a score, and every price links to the vendor."
  empty="No shortlist pages yet."
  entries={entries}
/>
