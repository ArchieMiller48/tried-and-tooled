---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, isoDate } from '../../lib/formatDate';
import { buildNewsletterIssueJsonLd } from '../../lib/schema';
import { withBase } from '../../lib/withBase';

export async function getStaticPaths() {
  const entries = await getCollection('newsletter', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const published = isoDate(d.date);
const description = d.summary;
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const archiveUrl = new URL(withBase('/newsletter/'), Astro.site).href;
const jsonLd = buildNewsletterIssueJsonLd({
  title: d.title,
  description,
  pageUrl,
  siteUrl,
  archiveUrl,
  datePublished: published,
  crumbs: [
    { name: 'Home', url: siteUrl },
    { name: 'Newsletter', url: archiveUrl },
    { name: d.title, url: pageUrl },
  ],
});
---
<Base title={d.title} description={description} jsonLd={jsonLd} hasNewsletter>
  <article class="wrap narrow prose" data-pagefind-body>
    <section class="hero" style="padding-bottom:8px">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={withBase('/')}>Home</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/newsletter/')}>Newsletter</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{d.title}</span>
      </nav>
      <span class="eyebrow">Issue {d.issue}</span>
      <h1 style="font-size:clamp(2rem,4vw,2.8rem)">{d.title}</h1>
      {d.subtitle && <p class="lead">{d.subtitle}</p>}
      <div class="meta">
        <span class="tag pending">Pending hands-on test</span>
        <span class="tag">Sent <time datetime={published}>{formatDate(d.date)}</time></span>
      </div>
      <p><a href={d.beehiivUrl} target="_blank" rel="noopener noreferrer">Read this issue on Beehiiv</a></p>
    </section>
    <Content />
  </article>
  <div class="wrap"><section><Newsletter /></section></div>
</Base>
