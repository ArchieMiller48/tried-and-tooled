---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import { formatDate, isoDate } from '../../lib/formatDate';
import { buildNewsletterIndexJsonLd } from '../../lib/schema';
import { withBase } from '../../lib/withBase';

const issues = (await getCollection('newsletter', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || b.data.issue - a.data.issue,
);
const description = "Past issues of the Tried & Tooled weekly. One stack, the week's changes, and prices taken from the vendor's own page.";
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const latest = issues.reduce((max, entry) => (entry.data.date > max ? entry.data.date : max), issues[0].data.date);
const jsonLd = buildNewsletterIndexJsonLd({
  pageUrl,
  siteUrl,
  description,
  dateModified: isoDate(latest),
  posts: issues.map((entry) => ({
    title: entry.data.title,
    url: new URL(withBase(`/newsletter/${entry.id}/`), Astro.site).href,
    datePublished: isoDate(entry.data.date),
  })),
});
---
<Base title="Newsletter" description={description} jsonLd={jsonLd}>
  <div class="wrap narrow" data-pagefind-body>
    <section class="hero" style="padding-bottom:8px">
      <span class="eyebrow">Weekly</span>
      <h1>Newsletter</h1>
      <p class="lead">A weekly note for anyone choosing an AI tool. Each issue has one job, what changed, and the prices checked on the vendor's own page. Every pick is pending a hands-on test. Nobody pays to rank.</p>
    </section>
    <div class="issue-list">
      {issues.map((entry) => (
        <article class="feed-item">
          <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
          <div>
            <span class="tag">Issue {entry.data.issue}</span>
            <h2><a href={withBase(`/newsletter/${entry.id}/`)}>{entry.data.title}</a></h2>
            <p>{entry.data.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
  <div class="wrap"><section><Newsletter /></section></div>
</Base>
