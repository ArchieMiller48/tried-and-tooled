---
import { getCollection } from 'astro:content';
import GuideIndex from '../../components/GuideIndex.astro';

const entries = (await getCollection('compare', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .map((entry) => ({
    href: `/compare/${entry.id}/`,
    kind: 'Compare',
    title: entry.data.title,
    summary: entry.data.summary,
    testStatus: entry.data.testStatus,
  }));
---
<GuideIndex
  title="Comparisons"
  eyebrow="Compare"
  description="Head-to-head pages for AI tools, with sourced pricing and a pending-test label until a hands-on task has been run."
  intro="Each comparison answers one choice, such as which builder to open for an MVP. Prices link to the vendor, and nothing here is a hands-on score."
  empty="No comparison pages yet."
  entries={entries}
/>
