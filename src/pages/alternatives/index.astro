---
import GuideIndex from '../../components/GuideIndex.astro';
import { guideIndexEntries } from '../../lib/guides';

const entries = await guideIndexEntries('alternatives');
---
<GuideIndex
  title="Alternatives"
  eyebrow="Alternatives"
  description="Alternatives to individual AI tools, with sourced pricing. Pages are added as markdown files."
  intro="When a page names one tool and the realistic swaps, it will be listed here. Each one stays tied to a use case."
  empty="No alternatives pages yet. The first guides are the Lovable and Bolt comparison and the app-builder shortlist."
  entries={entries}
/>
