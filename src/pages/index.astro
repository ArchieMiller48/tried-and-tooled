---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import UseCaseCard from '../components/UseCaseCard.astro';
import GuideCard from '../components/GuideCard.astro';
import { withBase } from '../lib/withBase';
import { hasGuideEntries, listGuides } from '../lib/guides';
import { isoDate } from '../lib/formatDate';
import { buildHomeJsonLd } from '../lib/schema';
import { USE_CASE_GROUPS } from '../lib/useCaseGroups';
import { getCollection } from 'astro:content';
const useCases = (await getCollection('use-cases', ({ data }) => !data.draft)).sort((a, b) => a.data.title.localeCompare(b.data.title));
const guides = await listGuides();
const allNews = (await getCollection('news')).sort((a, b) => b.data.spotted.valueOf() - a.data.spotted.valueOf());
const news = allNews.slice(0, 4);
const newsletterDates = (await getCollection('newsletter', ({ data }) => !data.draft)).map((entry) => entry.data.date);
const guideDates: Date[] = [];
for (const folder of ['compare', 'best', 'alternatives', 'pricing'] as const) {
  if (!hasGuideEntries(folder)) continue;
  for (const entry of await getCollection(folder, ({ data }) => !data.draft)) guideDates.push(entry.data.lastVerified);
}
const latest = [...useCases.map((entry) => entry.data.lastVerified), ...allNews.map((entry) => entry.data.spotted), ...guideDates, ...newsletterDates]
  .reduce((max, date) => (date > max ? date : max));
const description = 'The right AI tool for any job: a top pick, a budget pick and one to avoid, with sourced prices.';
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const jsonLd = buildHomeJsonLd({
  siteUrl,
  logoUrl: new URL(`${import.meta.env.BASE_URL}brand/logo-512.png`, Astro.site).href,
  description,
  dateModified: isoDate(latest),
});
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <section class="hero">
      <span class="eyebrow">For any job · curated picks</span>
      <h1>The right AI tool<br />for any job.</h1>
      <p class="lead">A directory organised by the job, not by who you are. Pick research, marketing, design, admin, study or building an app. Each page names a top pick, a budget pick and one to avoid. Every price links to its source and shows the date we checked it.</p>
      <div class="cta-row">
        <a class="btn" href={withBase('/find-your-tool/')}>Find your tool</a>
        <a class="btn ghost" href={withBase('/use-cases/')}>Browse use cases</a>
        <a class="btn ghost" href={withBase('/new/')}>What's new this week</a>
      </div>
    </section>

    <section class="finder-banner" aria-labelledby="finder-cta-title">
      <div>
        <span class="eyebrow">Start here</span>
        <h2 id="finder-cta-title">Find your tool</h2>
        <p>Four clicks: your role, how you feel about code, the jobs you care about and your budget. We'll line up the tools this site already tracks, with sourced prices and the same pending-test labels.</p>
      </div>
      <a class="btn" href={withBase('/find-your-tool/')}>Find your tool</a>
    </section>

    <section>
      <div class="pillars">
        <div class="card"><h3>🎯 Job first</h3><p>Every page answers one job you actually have, not "top 100 AI tools".</p></div>
        <div class="card"><h3>🧪 Proof over hype</h3><p>Test notes, verified pricing with sources, and a "last verified" date on every page. Untested means labelled untested.</p></div>
        <div class="card"><h3>🧱 Full stacks</h3><p>We show how tools fit together, from the first prompt to the finished job.</p></div>
        <div class="card"><h3>🚫 Never pay-to-rank</h3><p>Sponsors and affiliate deals never change a ranking. <a href={withBase('/about/')}>Read the policy</a>.</p></div>
      </div>
    </section>

    {USE_CASE_GROUPS.map((group, index) => {
      const items = useCases.filter((entry) => entry.data.category === group.category);
      return items.length > 0 && (
        <section>
          <div class="section-head">
            <h2>{group.label}</h2>
            {index === 0 && <a href={withBase('/use-cases/')}>All use cases →</a>}
          </div>
          <div class="grid">{items.map((entry) => <UseCaseCard entry={entry} />)}</div>
        </section>
      );
    })}

    {guides.length > 0 && (
      <section>
        <div class="section-head">
          <h2>Comparisons and shortlists</h2>
          <span><a href={withBase('/compare/')}>Comparisons</a> · <a href={withBase('/best/')}>Shortlists</a></span>
        </div>
        <div class="grid">{guides.map((guide) => <GuideCard {...guide} />)}</div>
      </section>
    )}

    <section>
      <div class="section-head"><h2>New this week</h2><a href={withBase('/new/')}>Full feed →</a></div>
      <div class="grid">
        {news.map((n) => (
          <a class="card" href={withBase(`/new/#${n.id}`)}>
            <span class="tag">{n.data.tool}</span>
            <h3 style="margin-top:10px">{n.data.title}</h3>
            <p>{n.data.summary}</p>
            <div class="meta"><span class="tag">Spotted {fmt(n.data.spotted)}</span></div>
          </a>
        ))}
      </div>
    </section>

    <section><Newsletter /></section>
  </div>
</Base>
