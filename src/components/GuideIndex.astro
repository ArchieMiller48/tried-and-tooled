---
import Base from '../layouts/Base.astro';
import Checked from './Checked.astro';
import Crumbs from './Crumbs.astro';
import GuideCard from './GuideCard.astro';
import { hubPage } from '../lib/hubPage';
import { withBase } from '../lib/withBase';
interface Entry {
  href: string;
  kind: string;
  title: string;
  summary: string;
  testStatus: 'pending' | 'tested';
  parentHref?: string;
  parentTitle?: string;
}
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  intro: string;
  empty: string;
  entries: Entry[];
}
const { title, description, eyebrow, intro, empty, entries } = Astro.props;
const hub = hubPage(Astro.site!, Astro.url.pathname, title, description);
---
<Base title={title} description={description} jsonLd={hub.jsonLd}>
  <div class="wrap" data-pagefind-body>
    <section class="hero" style="padding-bottom:16px">
      <Crumbs items={[{ href: withBase('/'), label: 'Home' }, { label: title }]} />
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p class="lead">{intro}</p>
      <div class="meta"><Checked date={hub.dateModified} label={hub.dateLabel} /></div>
    </section>
    {entries.length > 0 ? (
      <section>
        <h2 class="sr-only">Published pages</h2>
        <div class="grid">
          {entries.map((entry) => (
            <div>
              <GuideCard href={entry.href} kind={entry.kind} title={entry.title} summary={entry.summary} testStatus={entry.testStatus} />
              {entry.parentHref && entry.parentTitle && (
                <p class="guide-parent">Part of <a href={withBase(entry.parentHref)}>{entry.parentTitle}</a></p>
              )}
            </div>
          ))}
        </div>
      </section>
    ) : (
      <section>
        <p class="notice">{empty}</p>
        <p><a href={withBase('/use-cases/')}>Browse use cases</a></p>
      </section>
    )}
  </div>
</Base>
