---
/**
 * Beehiiv inline embed (form builder v3).
 * Snippet: https://subscribe-forms.beehiiv.com/v3/loader.js
 *   data-beehiiv-form="<uuid>"
 * The loader builds an iframe and resizes it from the form. It copies
 * utm_source / utm_medium / utm_campaign from the parent page, and skips
 * utm_content. This page writes all four onto the iframe URL before the
 * first load. The form stores source, medium, and campaign. It has no
 * utm_content field; the path is still on the iframe URL.
 */
interface Props {
  variant?: 'subtle';
}
const { variant } = Astro.props;
const subtle = variant === 'subtle';

const FORM_ID = 'd293e9f8-7032-40a9-b09b-958e9f366204';
const BEEHIIV_SUBSCRIBE = 'https://archies-newsletter-77bb75.beehiiv.com/subscribe';

const pagePath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const utm = {
  utm_source: 'tried-and-tooled',
  utm_medium: 'site',
  utm_campaign: 'newsletter',
  utm_content: pagePath,
};

const fallbackUrl = new URL(BEEHIIV_SUBSCRIBE);
for (const [key, value] of Object.entries(utm)) fallbackUrl.searchParams.set(key, value);
---
<div class:list={['newsletter', { subtle }]} id="newsletter">
  <div>
    {subtle ? (
      <>
        <h2>Price changes, once a week</h2>
        <p>The Tuesday note: one stack, and an alert when a price or an avoid on a tool we track changes.</p>
      </>
    ) : (
      <>
        <h2>The weekly: tools worth your time</h2>
        <p>Every Tuesday: the best new AI tools for vibe coders, creators and builders, one full stack of the week, and one price change or "avoid" alert. Five minutes, no hype.</p>
      </>
    )}
  </div>
  <div class="newsletter-embed">
    <script is:inline define:vars={{ utm }}>
      (function () {
        var patched = false;
        try {
          var desc = Object.getOwnPropertyDescriptor(HTMLIFrameElement.prototype, 'src');
          if (desc && desc.set && desc.configurable) {
            var orig = desc.set;
            Object.defineProperty(HTMLIFrameElement.prototype, 'src', {
              configurable: true,
              enumerable: desc.enumerable,
              get: desc.get,
              set: function (value) {
                try {
                  var url = new URL(value, window.location.href);
                  if (url.hostname === 'subscribe-forms.beehiiv.com') {
                    Object.keys(utm).forEach(function (key) {
                      url.searchParams.set(key, utm[key]);
                    });
                    value = url.toString();
                  }
                } catch (err) {}
                return orig.call(this, value);
              }
            });
            patched = true;
          }
        } catch (err) {}

        var root = document.currentScript && document.currentScript.parentNode;
        if (!root) return;
        var observer = new MutationObserver(function () {
          var iframe = root.querySelector('iframe');
          if (!iframe || iframe.dataset.ttReady === '1') return;
          iframe.title = 'Subscribe to Tried & Tooled';
          iframe.setAttribute('scrolling', 'no');
          if (!patched) {
            try {
              var url = new URL(iframe.src, window.location.href);
              var changed = false;
              Object.keys(utm).forEach(function (key) {
                if (url.searchParams.get(key) !== utm[key]) {
                  url.searchParams.set(key, utm[key]);
                  changed = true;
                }
              });
              if (changed) {
                iframe.src = url.toString();
                return;
              }
            } catch (err) {}
          }
          iframe.dataset.ttReady = '1';
        });
        observer.observe(root, { childList: true, subtree: true });
      })();
    </script>
    <script is:inline async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form={FORM_ID}></script>
  </div>
  <small>Form not showing? <a href={fallbackUrl.href}>Subscribe on Beehiiv</a>.</small>
</div>
