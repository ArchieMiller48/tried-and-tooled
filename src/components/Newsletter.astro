---
/**
 * Inline signup for the Beehiiv publication.
 *
 * The previous card loaded subscribe-forms.beehiiv.com/v3/loader.js, which
 * injects a cross-origin iframe. That hosted form is a max-content document
 * with 80px of padding and a long subtitle. The card clipped it to 560px
 * with overflow hidden, so on a narrow screen the email field sat outside
 * the visible box. When the loader is blocked (common for newsletter
 * scripts), nothing is injected and the only control left is the small
 * fallback link.
 *
 * This form posts straight to the publication subscribe page's no-JS
 * endpoint, the same fields as https://archies-newsletter-77bb75.beehiiv.com/subscribe
 * when JavaScript has not rewritten the form:
 *   POST /create
 *   email, sent_from_orchid, double_opt, auto_login_enabled,
 *   signup_flow_id, automation_ids, and the success/error messages.
 * No API key. Beehiiv responds in the browser with its confirmation page.
 */
import { withBase } from '../lib/withBase';

interface Props {
  variant?: 'subtle';
}
const { variant } = Astro.props;
const subtle = variant === 'subtle';

const BEEHIIV_CREATE = 'https://archies-newsletter-77bb75.beehiiv.com/create';
const BEEHIIV_SUBSCRIBE = 'https://archies-newsletter-77bb75.beehiiv.com/subscribe';

const pagePath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const onArchive = /^\/newsletter\/?$/.test(pagePath);
const utm = {
  utm_source: 'tried-and-tooled',
  utm_medium: 'site',
  utm_campaign: 'newsletter',
  utm_content: pagePath,
};

const action = new URL(BEEHIIV_CREATE);
const fallbackUrl = new URL(BEEHIIV_SUBSCRIBE);
for (const [key, value] of Object.entries(utm)) {
  action.searchParams.set(key, value);
  fallbackUrl.searchParams.set(key, value);
}
---
<div class:list={['newsletter', { subtle }]} id="newsletter">
  <div>
    {subtle ? (
      <>
        <h2>Price changes, once a week</h2>
        <p>The Tuesday note: one stack, and an alert when a price or an avoid on a tool we track changes.</p>
      </>
    ) : (
      <>
        <h2>The weekly: tools worth your time</h2>
        <p>Every Tuesday: the best new AI tools for vibe coders, creators and builders, one full stack of the week, and one price change or "avoid" alert. Five minutes, no hype.</p>
      </>
    )}
  </div>
  <form class="newsletter-form" method="post" action={action.href} accept-charset="UTF-8">
    <input type="hidden" name="subscribe_error_message" value="Oops, something went wrong." />
    <input type="hidden" name="subscribe_success_message" value="Subscribed!" />
    <input type="hidden" name="sent_from_orchid" value="true" />
    <input type="hidden" name="signup_flow_id" value="" />
    <input type="hidden" name="automation_ids" value="" />
    <input type="hidden" name="double_opt" value="false" />
    <input type="hidden" name="auto_login_enabled" value="true" />
    <label>
      <span class="sr-only">Email address</span>
      <input type="email" name="email" required autocomplete="email" placeholder="you@email.com" inputmode="email" />
    </label>
    <button type="submit">Subscribe free</button>
  </form>
  <small>
    Or <a href={fallbackUrl.href}>subscribe on Beehiiv</a>.
    {!onArchive && <> <a href={withBase('/newsletter/')}>Read past issues</a>.</>}
  </small>
</div>
