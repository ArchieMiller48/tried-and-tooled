---
/**
 * Beehiiv publication "Tried & Tooled".
 * The hosted site's home redirects to /subscribe, which is the signup flow.
 * Beehiiv's signup client reads `email` from the query string (and stores it
 * for later steps). UTM params are the documented acquisition fields.
 * https://www.beehiiv.com/support/article/42701649665559-understanding-subscriber-attribution-from-your-website
 */
const BEEHIIV_SUBSCRIBE = 'https://archies-newsletter-77bb75.beehiiv.com/subscribe';

const pagePath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const source = {
  utm_source: 'tried-and-tooled',
  utm_medium: 'site',
  utm_campaign: 'newsletter',
  utm_content: pagePath,
};

const fallbackUrl = new URL(BEEHIIV_SUBSCRIBE);
for (const [key, value] of Object.entries(source)) fallbackUrl.searchParams.set(key, value);
---
<div class="newsletter" id="newsletter">
  <div>
    <h2>The weekly: tools worth your time</h2>
    <p>Every Tuesday: the best new AI tools for vibe coders, creators and builders, one full stack of the week, and one price change or "avoid" alert. Five minutes, no hype.</p>
  </div>
  <form method="get" action={BEEHIIV_SUBSCRIBE}>
    {Object.entries(source).map(([key, value]) => <input type="hidden" name={key} value={value} />)}
    <label class="sr-only" for="nl-email" style="position:absolute;left:-9999px">Email</label>
    <input id="nl-email" name="email" type="email" required placeholder="you@example.com" autocomplete="email" />
    <button class="btn" type="submit">Subscribe</button>
  </form>
  <small>Subscribe opens Beehiiv with your email attached. Or <a href={fallbackUrl.href}>open the subscribe page</a>.</small>
</div>
