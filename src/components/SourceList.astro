---
interface Source { label: string; url: string }
interface Props { sources?: Source[] }
const { sources = [] } = Astro.props;
---
{sources.length > 0 && (
  <p class="sources">
    Sources:
    {sources.map((source, i) => (
      <>
        {i > 0 && ' · '}
        <a href={source.url} rel="nofollow noopener" target="_blank">{source.label}</a>
      </>
    ))}
  </p>
)}
