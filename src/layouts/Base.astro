---
import '../styles/global.css';
import { withBase } from '../lib/withBase';
import { clipMeta } from '../lib/metaText';
import listedOn from '../data/listed-on.json';
interface Props { title?: string; description?: string; jsonLd?: unknown; }
interface Listing { name: string; url: string; badgeImg?: string; }
const { title, description = 'Curated AI tool picks for any job, with a top pick, a budget pick, one to avoid and sourced prices.', jsonLd } = Astro.props;
const metaDescription = clipMeta(description);
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
const fullTitle = title ? `${title} · Tried & Tooled` : 'Tried & Tooled · The right AI tool for any job';
const path = Astro.url.pathname;
const notFound = /\/404\/?$/.test(path);
const pageUrl = notFound ? new URL(`${import.meta.env.BASE_URL}404.html`, Astro.site) : new URL(path, Astro.site);
const robots = notFound ? 'noindex, max-image-preview:large' : 'max-image-preview:large';
const ogImage = new URL(`${import.meta.env.BASE_URL}brand/og.png`, Astro.site);
const listings = (listedOn as Listing[]).filter((entry) => entry.name && entry.url);
const nav = [
  { href: withBase('/find-your-tool/'), label: 'Find your tool' },
  { href: withBase('/use-cases/'), label: 'Use cases' },
  { href: withBase('/new/'), label: 'New this week' },
  { href: withBase('/search/'), label: 'Search' },
  { href: withBase('/about/'), label: 'How we test' },
  { href: withBase('/submit/'), label: 'Submit a tool' },
];
const isCurrent = (href: string) => {
  const here = path.replace(/\/+$/, '') || '/';
  const target = href.replace(/\/+$/, '') || '/';
  return here === target || here.startsWith(`${target}/`);
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="uEpiyRTdYjuB-4--vrQe16Rws8kjLlXPB91qYV6Vlwg" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={pageUrl} />
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="logo" href={withBase('/')}>
          <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#0f172a"/><path d="M18 33l9 9 19-20" fill="none" stroke="#a3e635" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Tried &amp; Tooled
        </a>
        <nav class="main" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <a class="btn" href={path.includes('/newsletter/') ? '#newsletter' : withBase('/newsletter/')}>Get the weekly</a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site">
      <div class="wrap">
        <div>© {new Date().getFullYear()} Tried &amp; Tooled. Rankings are never for sale. Some links may be affiliate links; <a href={withBase('/about/#money')}>see how we make money</a>.</div>
        <div><a href={withBase('/newsletter/')}>Newsletter</a> · <a href={withBase('/about/')}>Editorial policy</a> · <a href={withBase('/submit/')}>Submit a tool</a> · <a href={withBase('/llms.txt')}>llms.txt</a></div>
        {listings.length > 0 && (
          <div class="listed-on">
            <span class="label">Listed on</span>
            {listings.map((entry) => (
              <a href={entry.url}>{entry.badgeImg ? <img src={withBase(entry.badgeImg)} alt={entry.name} /> : entry.name}</a>
            ))}
          </div>
        )}
      </div>
    </footer>
  </body>
</html>
