---
import '../styles/global.css';
import { withBase } from '../lib/withBase';
interface Props { title?: string; description?: string; }
const { title, description = 'Tested AI stacks for vibe coders, creators and builders. Which AI tool to use for which job, with verified pricing and honest test notes.' } = Astro.props;
const fullTitle = title ? `${title} · Tried & Tooled` : 'Tried & Tooled · Tested AI stacks for vibe coders, creators and builders';
const path = Astro.url.pathname;
const nav = [
  { href: withBase('/use-cases/'), label: 'Use cases' },
  { href: withBase('/new/'), label: 'New this week' },
  { href: withBase('/search/'), label: 'Search' },
  { href: withBase('/about/'), label: 'How we test' },
  { href: withBase('/submit/'), label: 'Submit a tool' },
];
const isCurrent = (href: string) => {
  const here = path.replace(/\/+$/, '') || '/';
  const target = href.replace(/\/+$/, '') || '/';
  return here === target || here.startsWith(`${target}/`);
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="uEpiyRTdYjuB-4--vrQe16Rws8kjLlXPB91qYV6Vlwg" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="logo" href={withBase('/')}>
          <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#0f172a"/><path d="M18 33l9 9 19-20" fill="none" stroke="#a3e635" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Tried &amp; Tooled
        </a>
        <nav class="main" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <a class="btn" href={withBase('/#newsletter')}>Get the weekly</a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site">
      <div class="wrap">
        <div>© {new Date().getFullYear()} Tried &amp; Tooled. Rankings are never for sale. Some links may be affiliate links; <a href={withBase('/about/#money')}>see how we make money</a>.</div>
        <div><a href={withBase('/about/')}>Editorial policy</a> · <a href={withBase('/submit/')}>Submit a tool</a></div>
      </div>
    </footer>
  </body>
</html>
